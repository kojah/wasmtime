; Struct returns (`sret`) are passed as a parameter, so a signature cannot
; use `sret` on a return value, or combine an `sret` parameter with return
; values. Lowering such signatures used to panic.
function %f0() -> i64 sret { ; error: Signature cannot have a struct return (`sret`) return value
block0:
    v0 = iconst.i64 0
    return v0
}

function %f1(i64 sret) -> i64 { ; error: Signature with a struct return (`sret`) parameter cannot have return values
block0(v0: i64):
    return v0
}

function %f2() {
    fn0 = colocated %g(i64 sret, i64) -> i64 sret fast ; error: Signature cannot have a struct return (`sret`) return value

block0:
    v0 = iconst.i64 0
    v1 = call fn0(v0, v0)
    return
}

; An `sret` parameter without return values is fine.
function %f3(i64 sret) {
    fn0 = %g(i64 sret)

block0(v0: i64):
    call fn0(v0)
    return
}
