function %try_call_tags(i64) tail {
    ss0 = explicit_slot 8, key = 0
    sig0 = (i64) tail
    fn0 = colocated %g(i64) tail
block0(v0: i64):
<ss0, 1, 2>      call fn0(v0)
<ss0, 3, 4>      try_call fn0(v0), sig0, block1, [ default: block2 ]
block1:
    return
block2:
    return
}

