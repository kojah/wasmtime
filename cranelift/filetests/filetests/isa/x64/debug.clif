;   leal (%r12, %r13), %eax
;   movq 0x40(%rsp), %r12
;   movq 0x48(%rsp), %r13
;   addq $0x50, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %f1(i32, i32) -> i32 {
    ss0 = explicit_slot 64, key = 1234
    fn0 = colocated %f1(i32, i32)
block0(v0: i32, v1: i32):
<ss0, 0, 0>      call fn0(v0, v1)
<ss0, 1, 0>      sequence_point
            v2 = iadd v0, v1
                 return v2
}

